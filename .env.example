# FILE MAP
#   1-8  Example environment for triagebench. Copy to ~/.config/triagebench/.env (outside the repo).
#
# CHANGE ME: a fine-grained GitHub token with public-repo read access only. Never commit it.
GITHUB_TOKEN=
# TWEAK: where raw API responses are cached (rebuilds read from here, not the network)
TRIAGEBENCH_CACHE_DIR=~/.cache/triagebench
